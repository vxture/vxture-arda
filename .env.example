# ============================================================
# arda runtime configuration TEMPLATE
# Convention (owner, 2026-08-10): all products share the SAME operator-env
# section skeleton and key order (reference: atlas/runos). Shared sections
# come first in the platform order; repo-specific keys sit at the end of
# their section or in clearly marked arda-specific sections. Values here are
# safe defaults/placeholders; real config lives at $ROOT_DIR/etc/.env on the
# host (read at container start - changes need an app restart; backups sit
# beside it as .env.bak.<stamp>).
#
# The SAME scripts deploy prod or beta; which stack runs is decided entirely
# by that file and the root it lives under:
#   prod : /srv/md0/arda/etc/.env       (values below as-is)
#   beta : /srv/md1/arda-beta/etc/.env  (apply the BETA OVERRIDES at the bottom)
# ============================================================

# --- Runtime ---
NODE_ENV=production
# arda-app is published on the deploy host's TAILNET only (host has no public
# IP); the shared public edge reverse-proxies to it over tailscale. Prod 3230,
# beta 3231 - both stacks coexist on one host.
APP_PUBLISH_PORT=3230
# arda-specific runtime identity: PROJECT_NAME drives the compose project AND
# container_name prefix (arda-* vs arda-beta-*); DEPLOY_STAGE feeds the
# /api/health identity block (org standard 025): production | beta | dev.
PROJECT_NAME=arda
NODE_NAME=ARDA_DEPLOY_HOST
DEPLOY_STAGE=production
APEX_DOMAIN=arda.vxture.com

# --- Server paths (arda-specific) ---
# md0 (1.8T RAID-1) carries prod, md1 (916G) beta. etc/ is the persistent
# operator-config home; deploy/ is disposable (CI rsync target = REPO_DIR);
# runtime/ is regenerated; data/ is the only backed-up state tree.
ROOT_DIR=/srv/md0/arda
REPO_DIR=/srv/md0/arda/deploy
RUNTIME_DIR=/srv/md0/arda/runtime
DATA_DIR=/srv/md0/arda/data
BACKUP_DIR=/srv/md0/arda/backup

# --- Database (own physical DB; name per runos ADR-007) ---
# vx_arda_db in EVERY environment (env lives in the stack/container name,
# never in the db name). POSTGRES_* initialize the container as the OWNER
# role; DATABASE_URL connects at RUNTIME as the least-privilege arda_svc role
# (97_service_role.sql) - its password is the ARDA_DB_SVC_PASSWORD secret.
# Schema is DDL-owned and changed only via the db-init pipeline; the
# entrypoint never migrates.
POSTGRES_DB=vx_arda_db
POSTGRES_PASSWORD=ChangeME
DATABASE_URL=postgresql://arda_svc:ChangeME@arda-db:5432/vx_arda_db?schema=public
# arda-specific: owner-role name used at first container init.
POSTGRES_USER=arda

# --- C1 OIDC RP (Vxture App Integration Standard v1.0) ---
# arda is an Authorization-Code + PKCE RP against accounts.vxture.com. Tokens
# live server-side in Redis; the browser only holds an opaque session cookie.
# Prod uses the `arda` client; beta is the SEPARATE `arda-beta` client (own
# secret - see BETA OVERRIDES): back-channel logout allows one logout URI per
# client, and separate clients isolate token audience + secret blast-radius.
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=arda
# Provisioned by the platform via secret manager; never commit the real value.
OIDC_CLIENT_SECRET=
# Must exactly match a registered redirect_uri on the client.
OIDC_REDIRECT_URI=https://arda.vxture.com/auth/callback
# Quoted: the deploy sources .env via bash, which would word-split bare spaces.
OIDC_SCOPES="openid profile email phone"
OIDC_POST_LOGOUT_REDIRECT_URI=https://arda.vxture.com/
# RP session lifetime in seconds (keep <= refresh TTL; default 30d).
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=vx_rp_session
# arda-specific: host-only cookie (NO leading dot) + the session store. The
# redis host must match this stack's container_name (${PROJECT_NAME}-redis).
RP_SESSION_COOKIE_DOMAIN=arda.vxture.com
REDIS_URL=redis://arda-redis:6379

# --- C2/C3 platform client (entitlement read + usage consume) ---
# Internal base URL of the vxture platform API; only set on the server. Omit
# in local dev to stay on MockEntitlementResolver. The token matches platform
# env AUTH_INTERNAL_TOKEN (x-vxture-internal-auth header). Owner delivers.
PLATFORM_API_URL=http://accounts.vxture.com
PLATFORM_INTERNAL_AUTH_TOKEN=

# --- C3 provisioning webhook (dual-secret rotation; NEXT = overlap slot) ---
# HMAC-SHA256 secret for inbound provisioning payloads; must match platform
# env ARDA_PROVISION_WEBHOOK_SECRET. During rotation set the incoming secret
# in _NEXT for the overlap window and clear it once rotation completes.
PROVISION_WEBHOOK_SECRET=
PROVISION_WEBHOOK_SECRET_NEXT=

# --- Atlas model-gateway client (arda-specific; ADR-013 / arda-biz-270) ---
# Atlas is a separate vxture product - the platform's sole model-inference/
# metering gateway. arda's Curator mints its own aud=atlas token-exchange
# bearer from the OIDC client above; it never uses the platform token. Leave
# ATLAS_BASE_URL blank to keep the Atlas client honestly not-implemented.
ATLAS_BASE_URL=
# Defaults when unset: /model-platform/chat, "atlas".
ATLAS_CHAT_PATH=
ATLAS_AUDIENCE=
# Exactly one of the two selects model choice: TASK_PROFILE = Atlas resolves
# from the tenant grant (wins if both set); MODEL = pinned modelCode.
ATLAS_CURATOR_TASK_PROFILE=
ATLAS_CURATOR_MODEL=

# --- App-layer encryption (arda-specific; data-130) ---
# AES-256-GCM key sealing DataSource.connectionConfig before persistence.
# 32 bytes base64: `openssl rand -base64 32`. Never commit.
DATA_ENCRYPTION_KEY=

# --- Internal jobs guard (arda-specific) ---
# x-internal-job-token for flush / lifecycle sweep / scheduled refresh
# endpoints; 404 fail-closed without a match. BLANK = endpoints disabled.
# Per-stack random value; never commit.
INTERNAL_JOB_TOKEN=

# --- App config (arda-specific) ---
DEFAULT_LANDING=/dashboard
# First-entry workspace seeding: "true" fills a never-seen workspace with the
# sample template (beta/demo). Keep "false" in prod - the platform owns
# seeding there (WorkspaceRef.seedStatus).
ARDA_SEED_AUTOFILL=false
# MockEntitlementResolver drivers (local dev / CI without a real IdP).
#   MOCK_STATE: trial | subscribed | expired | free   (default: subscribed)
#   MOCK_TIER:  free | starter | pro | business | enterprise  (default: pro)
MOCK_STATE=subscribed
MOCK_TIER=pro

# --- Integration status page (diagnostics; /status /api/status) ---
# Non-secret C1/C2/C3 config dump for operator verification - only presence
# booleans, never values. STATUS_PAGE: public | authed | off.
STATUS_PAGE=public
# on = show db host/name/role; off = hide.
STATUS_SHOW_INFRA=on

# --- Client-side stack identity (NEXT_PUBLIC_ = baked into browser bundle) ---
# EnvGuard redirects users landing on the wrong stack; console URL feeds
# upgrade/renew deep links (open only on explicit click).
NEXT_PUBLIC_APP_ENV=prod
NEXT_PUBLIC_PROD_URL=https://arda.vxture.com
NEXT_PUBLIC_BETA_URL=https://beta-arda.vxture.com
NEXT_PUBLIC_CONSOLE_URL=https://console.vxture.com

# --- Container images ---
# GHCR primary; FALLBACK_* is the Aliyun ACR mirror the deploy scripts use
# when a registry is unreachable from the host (library images are mirrored
# there by deploy.yml on every run). Owned image: arda-app.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=vxture
IMAGE_TAG=latest
FALLBACK_IMAGE_REGISTRY=crpi-xhjfv6mu59629oau.cn-beijing.personal.cr.aliyuncs.com
FALLBACK_IMAGE_NAMESPACE=vx-foundation

# --- Private packages ---
# @vxture/* scope source. pnpm 11: credentials never live in a committed
# project .npmrc - the token below is read by CI/user-level config only.
VXTURE_NPM_REGISTRY=https://npm.pkg.github.com
NODE_AUTH_TOKEN=

# --- Shared edge (informational; nothing here is consumed by this stack) ---
# TLS + *.vxture.com wildcard live on the shared public edge. arda only
# contributes vhost sources in configs/edge/*.conf; the edge upstream targets
# ARDA_DEPLOY_HOST:${APP_PUBLISH_PORT} over tailscale. This stack is plain
# HTTP on the tailnet; the edge is the only TLS hop.

# ==============================================================================
# BETA OVERRIDES (pre-release stack on md1)
# For /srv/md1/arda-beta/etc/.env keep everything above but change:
#
#   APP_PUBLISH_PORT=3231
#   PROJECT_NAME=arda-beta
#   DEPLOY_STAGE=beta
#   APEX_DOMAIN=beta-arda.vxture.com
#   ROOT_DIR=/srv/md1/arda-beta
#   REPO_DIR=/srv/md1/arda-beta/deploy
#   RUNTIME_DIR=/srv/md1/arda-beta/runtime
#   DATA_DIR=/srv/md1/arda-beta/data
#   BACKUP_DIR=/srv/md1/arda-beta/backup
#   DATABASE_URL=postgresql://arda_svc:<beta svc password>@arda-beta-db:5432/vx_arda_db?schema=public
#   POSTGRES_PASSWORD=<beta db password>
#   OIDC_CLIENT_ID=arda-beta
#   OIDC_CLIENT_SECRET=<the arda-beta client secret>
#   OIDC_REDIRECT_URI=https://beta-arda.vxture.com/auth/callback
#   OIDC_POST_LOGOUT_REDIRECT_URI=https://beta-arda.vxture.com/
#   RP_SESSION_COOKIE_DOMAIN=beta-arda.vxture.com
#   REDIS_URL=redis://arda-beta-redis:6379
#   MOCK_STATE=trial
#   NEXT_PUBLIC_APP_ENV=beta
#
# POSTGRES_DB is NOT overridden: ADR-007 - vx_arda_db in every environment.
# Beta is a SEPARATE OIDC client (arda-beta) with its own secret; required
# for back-channel logout (one logout URI per client) and blast-radius
# isolation. Both clients authenticate the same IdP realm.
# ==============================================================================
