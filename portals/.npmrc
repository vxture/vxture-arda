# Scope->registry mapping ONLY. pnpm 11 no longer env-expands credentials in a
# committed project .npmrc (#191 supply-chain hardening): auth lives in the
# user-level ~/.npmrc (dev machines / CI writes it from NODE_AUTH_TOKEN; the
# Dockerfile deps stage writes its own from the BuildKit secret).
@vxture:registry=https://npm.pkg.github.com
# Next.js standalone build + the deps-stage COPY assume a flat, hoisted
# node_modules (as npm produced). pnpm defaults to an isolated store, so pin the
# hoisted linker to keep the build working after the D4 npm->pnpm migration.
node-linker=hoisted
