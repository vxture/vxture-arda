# arda beta operator env template - copy to /srv/md1/arda-beta/etc/.env and
# fill ChangeME values. Same skeleton/key order as prod.env; only the values
# marked by the BETA OVERRIDES block in .env.example differ.

# --- Runtime ---
NODE_ENV=production
APP_PUBLISH_PORT=3231
PROJECT_NAME=arda-beta
NODE_NAME=ARDA_DEPLOY_HOST
DEPLOY_STAGE=beta
APEX_DOMAIN=beta-arda.vxture.com

# --- Server paths ---
ROOT_DIR=/srv/md1/arda-beta
REPO_DIR=/srv/md1/arda-beta/deploy
RUNTIME_DIR=/srv/md1/arda-beta/runtime
DATA_DIR=/srv/md1/arda-beta/data
BACKUP_DIR=/srv/md1/arda-beta/backup

# --- Database (ADR-007: vx_arda_db in every environment) ---
POSTGRES_DB=vx_arda_db
POSTGRES_PASSWORD=ChangeME
DATABASE_URL=postgresql://arda_svc:ChangeME@arda-beta-db:5432/vx_arda_db?schema=public
POSTGRES_USER=arda

# --- C1 OIDC RP (separate arda-beta client, own secret) ---
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=arda-beta
OIDC_CLIENT_SECRET=ChangeME
OIDC_REDIRECT_URI=https://beta-arda.vxture.com/auth/callback
OIDC_SCOPES="openid profile email phone"
OIDC_POST_LOGOUT_REDIRECT_URI=https://beta-arda.vxture.com/
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=vx_rp_session
RP_SESSION_COOKIE_DOMAIN=beta-arda.vxture.com
REDIS_URL=redis://arda-beta-redis:6379

# --- C2/C3 platform client ---
PLATFORM_API_URL=ChangeME
PLATFORM_INTERNAL_AUTH_TOKEN=ChangeME

# --- C3 provisioning webhook ---
PROVISION_WEBHOOK_SECRET=ChangeME
PROVISION_WEBHOOK_SECRET_NEXT=

# --- App-layer encryption ---
DATA_ENCRYPTION_KEY=ChangeME

# --- Internal jobs guard ---
INTERNAL_JOB_TOKEN=ChangeME

# --- App config ---
DEFAULT_LANDING=/dashboard
ARDA_SEED_AUTOFILL=false
MOCK_STATE=trial
MOCK_TIER=pro

# --- Client-side stack identity ---
NEXT_PUBLIC_APP_ENV=beta
NEXT_PUBLIC_PROD_URL=https://arda.vxture.com
NEXT_PUBLIC_BETA_URL=https://beta-arda.vxture.com
NEXT_PUBLIC_CONSOLE_URL=https://console.vxture.com

# --- Container images ---
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=vxture
IMAGE_TAG=latest
FALLBACK_IMAGE_REGISTRY=crpi-xhjfv6mu59629oau.cn-beijing.personal.cr.aliyuncs.com
FALLBACK_IMAGE_NAMESPACE=vx-foundation