# arda prod operator env template - copy to /srv/md0/arda/etc/.env and fill
# ChangeME values. Section skeleton + key order per the platform convention
# (owner 2026-08-10); full key documentation in the repo-root .env.example.

# --- Runtime ---
NODE_ENV=production
APP_PUBLISH_PORT=3230
PROJECT_NAME=arda
NODE_NAME=ARDA_DEPLOY_HOST
DEPLOY_STAGE=production
APEX_DOMAIN=arda.vxture.com

# --- Server paths ---
ROOT_DIR=/srv/md0/arda
REPO_DIR=/srv/md0/arda/deploy
RUNTIME_DIR=/srv/md0/arda/runtime
DATA_DIR=/srv/md0/arda/data
BACKUP_DIR=/srv/md0/arda/backup

# --- Database (ADR-007: vx_arda_db in every environment) ---
POSTGRES_DB=vx_arda_db
POSTGRES_PASSWORD=ChangeME
# Runtime connects as least-privilege arda_svc (97_service_role.sql), not the
# owner; the password is the ARDA_DB_SVC_PASSWORD secret (owner delivers).
DATABASE_URL=postgresql://arda_svc:ChangeME@arda-db:5432/vx_arda_db?schema=public
POSTGRES_USER=arda

# --- C1 OIDC RP ---
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=arda
OIDC_CLIENT_SECRET=ChangeME
OIDC_REDIRECT_URI=https://arda.vxture.com/auth/callback
OIDC_SCOPES="openid profile email phone"
OIDC_POST_LOGOUT_REDIRECT_URI=https://arda.vxture.com/
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=vx_rp_session
RP_SESSION_COOKIE_DOMAIN=arda.vxture.com
REDIS_URL=redis://arda-redis:6379

# --- S2S inbound (as callee; token exchange per product_210) ---
# aud on exchange tokens; act.sub allow-list of products arda accepts calls
# from. EMPTY = bearer plane disabled (fail closed). Comma-separated.
S2S_AUDIENCE=arda
S2S_ALLOWED_CALLERS=

# --- C2/C3 platform client ---
PLATFORM_API_URL=ChangeME
PLATFORM_INTERNAL_AUTH_TOKEN=ChangeME

# --- C3 provisioning webhook ---
PROVISION_WEBHOOK_SECRET=ChangeME
PROVISION_WEBHOOK_SECRET_NEXT=

# --- App-layer encryption ---
DATA_ENCRYPTION_KEY=ChangeME

# --- Internal jobs guard ---
INTERNAL_JOB_TOKEN=ChangeME

# --- App config ---
DEFAULT_LANDING=/dashboard
ARDA_SEED_AUTOFILL=false
MOCK_TIER=pro

# --- Client-side stack identity ---
NEXT_PUBLIC_APP_ENV=prod
NEXT_PUBLIC_PROD_URL=https://arda.vxture.com
NEXT_PUBLIC_BETA_URL=https://beta-arda.vxture.com
NEXT_PUBLIC_CONSOLE_URL=https://console.vxture.com

# --- Container images ---
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=vxture
IMAGE_TAG=latest
FALLBACK_IMAGE_REGISTRY=crpi-xhjfv6mu59629oau.cn-beijing.personal.cr.aliyuncs.com
FALLBACK_IMAGE_NAMESPACE=vx-foundation